# Copie para .env e preencha. NUNCA faça commit do .env.

# Domínio apontado para o IP do VPS (ex.: agendar.suabarbearia.com.br)
DOMINIO=agendar.suabarbearia.com.br

BARBEARIA_NOME=Minha Barbearia

# Senha do banco (invente uma forte)
POSTGRES_PASSWORD=troque-esta-senha-do-banco

# Login do painel /admin.html (senha com 10+ caracteres)
ADMIN_USUARIO=admin
ADMIN_SENHA=troque-esta-senha-do-painel

# Comece com "simulador" para testar o fluxo online; depois troque para "mercadopago"
PAGAMENTO_PROVEDOR=simulador
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=https://agendar.suabarbearia.com.br/api/pagamentos/webhook/mercadopago
